<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>
        <LangVersion>14</LangVersion>
        <RootNamespace>xunitv3.template</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    </PropertyGroup>
    
    <ItemGroup>
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
        <PackageReference Include="OpenTelemetry" Version="1.20.1" />
        <PackageReference Include="OpenTelemetry.Exporter.InMemory" Version="1.20.1" />
        <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
    </ItemGroup>

</Project>